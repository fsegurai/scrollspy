{
  "name": "@fsegurai/scrollspy-monorepo",
  "version": "2.0.0",
  "description": "A simple, framework-agnostic Scrollspy script for navigation and table of contents.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Fabián Segura",
    "url": "https://fsegurai.com"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0",
    "npm": ">=11"
  },
  "keywords": [
    "accessibility",
    "framework-agnostic",
    "javascript",
    "javascript-library",
    "lightweight",
    "library",
    "navigation",
    "scrollspy",
    "scroll",
    "table-of-contents",
    "toc",
    "typescript",
    "typescript-library"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "bun run clean",
    "prepare": "husky",
    "build": "bun run build:packages && bun run build:packages:metadata && bun run build:demo && bun run build:demo:metadata",
    "build:packages": "bun run --filter '*' pkg:build",
    "build:demo": "vite build",
    "build:packages:metadata": "find ./packages -maxdepth 1 -type d ! -name '.helper' ! -name 'packages' -exec cp ./LICENSE {} \\;",
    "build:demo:metadata": "cp ./README.md ./demo/dist/README.md && cp ./LICENSE ./demo/dist/LICENSE",
    "clean": "bun run clean:packages && bun run clean:demo && bun run clean:coverage",
    "clean:packages": "rimraf --glob ./packages/*/dist",
    "clean:demo": "rimraf --glob ./demo/dist ./demo/README.md ./demo/LICENSE",
    "clean:coverage": "rimraf --glob ./coverage",
    "start": "vite",
    "start:dev": "portless run vite preview",
    "start:dev:reset": "portless proxy stop || true",
    "start:debug": "portless run vite --debug",
    "start:prod": "vite preview",
    "test": "bun run --filter '*' pkg:test",
    "test:coverage": "bun test --coverage",
    "test:snapshots": "bun test --update-snapshots",
    "test:summary": "bun run packages/.helper/utils/scripts/test-packages-summary.ts --summary",
    "test:packages": "bun run --filter '*' pkg:test:coverage",
    "test:packages:snapshots": "bun run --filter '*' pkg:test -- --update-snapshots",
    "lint": "bun run lint:packages && bun run lint:demo",
    "lint:check": "biome check",
    "lint:fix": "biome check --write",
    "lint:packages": "biome lint packages/*/src/",
    "lint:demo": "biome lint demo/",
    "format": "biome check --write",
    "format:audit": "biome check"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "clipboard": "^2.0.11",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/prismjs": "^1.26.6",
    "@typescript/typescript6": "^6.0.2",
    "bun-types": "^1.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "portless": "^0.15.6",
    "rimraf": "^6.1.3",
    "terser": "^5.51.2",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1"
  }
}
